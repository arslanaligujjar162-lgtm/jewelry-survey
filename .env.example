# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site origin for canonical URLs, sitemap and link-preview images. Leave unset
# on Vercel to use the project's production domain automatically; set it only
# if that's wrong. A wrong value breaks WhatsApp/Instagram link previews.
NEXT_PUBLIC_SITE_URL=

# Payments — gateway stays off until a merchant account is approved
NEXT_PUBLIC_GATEWAY_ENABLED=false

# Analytics (optional). The Meta Pixel ID is what lets Instagram ads measure sales.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# New-order email alerts via Resend (free tier). Until a sending domain is
# verified in Resend, alerts can only go to the address the Resend account
# was created with.
RESEND_API_KEY=
ORDER_ALERT_EMAIL=
# ORDER_ALERT_FROM="1720 Orders <orders@your-domain.pk>"

# Phone verification at checkout (optional). Leave all three unset to take
# Cash on Delivery orders without an SMS code and confirm them on WhatsApp.
# Setting all three turns SMS verification on.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Error monitoring (optional) — POST target for src/lib/monitoring.ts.
# Point at a Sentry envelope endpoint, a logging service, or leave unset to
# only log to the console/server logs.
MONITORING_WEBHOOK_URL=
