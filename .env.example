# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://7teen2wenty.pk

# Payments — gateway stays off until a merchant account is approved
NEXT_PUBLIC_GATEWAY_ENABLED=false

# Analytics (optional)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# WhatsApp Cloud API (wired later)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Error monitoring (optional) — POST target for src/lib/monitoring.ts.
# Point at a Sentry envelope endpoint, a logging service, or leave unset to
# only log to the console/server logs.
MONITORING_WEBHOOK_URL=
